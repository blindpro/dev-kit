class project
{
ini config;
string name;
string main_script;
string language;
bool git_installed;
bool has_repo;
compiler c;
project()
{
detect_repo();
int num = build_config();
if(num == 0)
{
config.load("project.ini");
name = config.get_string("genral","name");
language = config.get_string("genral","language");
main_script = config.get_string("genral","main script");
}
detect_compiler();
}
int build_config()
{
if(file_exists("project.ini"))
{
return 0;
}
file_put_contents("project.ini","");
config.load("project.ini");
config.create_section("genral");
config.set_bool("genral","has repo",has_repo);
name = input_box("enter name","Enter the name of your project");
config.set_string("genral","name",name);
main_script = input_box("enter main script","Enter the filename of the main script of your project");
config.set_string("genral","main script",main_script);
language = input_box("enter language","Enter the programming language of the project.");
config.set_string("genral","language",language);
config.save("project.ini");
return 1;
}
void detect_compiler()
{
language = language.lower();
if(language == "nvgt")
{
c = compiler("nvgt",main_script);
}
else if(language == "c++" or language == "cpp")
{
c = compiler("g++",main_script);
}
else if(language == "hugo")
{
c = compiler("hugo",main_script);
}
}
void refresh()
{
detect_repo();
}
void detect_repo()
{
if(directory_exists(".git"))
{
has_repo = true;
}
else
{
has_repo = false;
}
}
}