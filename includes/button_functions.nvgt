void on_check_status()
{
speak(g.get_status());
}
void on_commit()
{
speak(g.commit());
}
void on_create_repo()
{
speak(g.create_repo());
p.refresh();
build_git_screen();
}
void on_stage_all()
{
g.stage_all();
speak("all files staged");
}
void load_home()
{
gui.load_screen("home");
speak("home screen");
}
void load_git()
{
gui.load_screen("git");
speak("git management screen");
}