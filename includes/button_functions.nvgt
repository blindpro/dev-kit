void on_create_repo()
{
speak(g.create_repo());
p.refresh();
}
void on_check_status()
{
speak(g.get_status());
}
void on_commit()
{
speak(g.commit());
}
void on_stage()
{
string path = input_box("stage file","Please enter the file you want to stage.");
string output = g.stage(path);
if(output == "blank")
{
speak("file staged");
return;
}
speak(output);
}
void on_stage_all()
{
g.stage_all();
speak("all files staged");
}
void on_unstage()
{
string path = input_box("unstage file","Please enter the file you want to unstage.");
string output = g.unstage(path);
if(output == "blank")
{
speak("file staged");
return;
}
speak(output);
}
void on_unstage_all()
{
speak(g.unstage_all());
}
void on_push()
{
speak("pushing to remote...");
speak(g.push());
}
void on_view_remote_url()
{
string[] remotes = g.get_remotes();
int pos = gui.get_list_pazition("remotes");
speak(g.get_remote_url(remotes[pos]));
}
void on_add_remote()
{
string name = input_box("add remote","Enter remote name");
string url = input_box("add remote","Enter remote url");
speak("adding remote "+name+"...");
speak(g.add_remote(name,url));
load_remotes();
}
void on_delete_remote()
{
string[] remotes = g.get_remotes();
int pos = gui.get_list_pazition("remotes");
string confirm = input_box("delete remote","Are you sure you want to delete the remote "+remotes[pos]+"? Type "+remotes[pos]+" to confirm.");
if(confirm == remotes[pos])
{
speak(g.delete_remote(remotes[pos]));
speak("remote "+remotes[pos]+"deleted.");
}
else
{
speak("deletion of remote "+remotes[pos]+" canseld.");
}
}
void on_create_branch()
{
string branch = input_box("create branch","Enter branch name");
speak("creating branch "+branch+"...");
speak(g.create_branch(branch));
load_branch();
}
void on_switch_branch()
{
string[] branches = g.get_branches();
int pos = gui.get_list_pazition("branches");
string branch = branches[pos];
branch = branch.replace("*","");
branch = branch.trim_whitespace();
speak("switching to branch "+branch+"...");
speak(g.switch_branch(branch));
load_branch();
}
void on_merge_branch()
{
string[] branches = g.get_branches();
string branch = branches[gui.get_list_pazition("branches")];
branch = branch.replace("*","");
branch = branch.trim_whitespace();
string confirm = input_box("Merge branch","Are you sure you want to merge branch "+branch+"? Type merge to confirm");
if(confirm == "merge")
{
speak("merging branch "+branch+"...");
speak(g.merge_branch(branch));

}
else
{
speak("merge canseld");
}
}
void on_delete_branch()
{
string[] branches = g.get_branches();
int pos = gui.get_list_pazition("branches");
string branch = branches[pos];
branch = branch.replace("*","");
branch = branch.trim_whitespace();
string confirm = input_box("delete branch","Are you sure you want to delete branch "+branch+"? This action can not be undone! Type the branch name to confirm.");
if(confirm == branch)
{
speak("deleting branch "+branch+"...");
speak(g.delete_branch(branch));
load_branch();
}
else
{
speak("branch deletion canseld.");
}
}
void on_get_commit_hash()
{
string[] history = g.get_history();
int pos = gui.get_list_pazition("history");
string commit = history[pos];
string[] data = commit.split(" ");
string hash = data[0];
clipboard_set_text(hash);
speak("commit hash copied to clipboard.");
}
void load_home()
{
gui.load_screen("home");
speak("home screen");
}
void load_git()
{
if(!p.git_installed)
{
speak("functions disabled because git is not installed");
return;
}
gui.load_screen("git");
speak("git management screen");
}
void load_branch()
{
speak("branch management screen");
gui.load_screen("branch management");
gui.clear_list("branches");
string[] branches = g.get_branches();
for(int i = 0; i<branches.length(); i++)
{
gui.add_list_item("branches",branches[i]);
}
}
void load_history()
{
speak("history screen");
gui.load_screen("history");
gui.clear_list("history");
string[] history = g.get_history();
for(int i = 0; i<history.length(); i++)
{
gui.add_list_item("history",history[i]);
}
}
void load_remotes()
{
speak("remote management screen");
gui.load_screen("remote management");
gui.clear_list("remotes");
string[] remotes = g.get_remotes();
for(int i = 0; i<remotes.length(); i++)
{
gui.add_list_item("remotes",remotes[i]);
}
}
void load_gh()
{
if(gh.show_gh)
{
gui.load_screen("github management");
}
}
void load_project()
{
speak("project management screen");
gui.load_screen("project");
}
void on_view_project_info()
{
info_box("project info","info for "+p.name,"project name: "+p.name+"\r\nproject language: "+p.language+"\r\nproject compiler: "+p.c.name);
}
void on_build()
{
speak("building project...");
speak(p.c.build());
}
void on_run()
{
if(p.c.run_command == "")
{
speak("No run command for current compiler");
}
speak("running project...");
speak(p.c.run());
}
