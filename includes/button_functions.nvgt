void on_create_repo()
{
speak(g.create_repo());
p.refresh();
build_git_screen();
}
void on_check_status()
{
speak(g.get_status());
}
void on_commit()
{
speak(g.commit());
}
void on_stage_all()
{
g.stage_all();
speak("all files staged");
}
void on_push()
{
speak("pushing to remote...");
speak(g.push());
}

void load_home()
{
gui.load_screen("home");
speak("home screen");
}
void load_git()
{
gui.load_screen("git");
speak("git management screen");
}
void load_project()
{
speak("project management screen");
gui.load_screen("project");
}
void on_view_project_info()
{
info_box("project info","info for "+p.name,"project name: "+p.name+"\r\nproject language: "+p.language+"\r\nproject compiler: "+p.compiler);
}