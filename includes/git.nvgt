class git
{
string create_repo()
{
return shell.send_wait("git init");
}
string get_status()
{
return shell.send_wait("git status");
}
void stage_all()
{
shell.send("git add .");
}
string commit()
{
return shell.send_wait("git commit");
}
bool has_remotes()
{
string remotes = shell.send_wait("git remote");
return remotes != "";
}
string push()
{
return shell.send_wait("git push");
}
}