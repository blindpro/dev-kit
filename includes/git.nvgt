class git
{
string create_repo()
{
return shell.send_wait("git init");
}
string get_status()
{
return shell.send_wait("git status");
}
string stage_all()
{
return shell.send_wait("git add .");
}
string commit()
{
return shell.send_wait("git commit");
}
bool has_remotes()
{
string remotes = shell.send_wait("git remote");
return remotes != "";
}
string push()
{
return shell.send_wait("git push");
}
string[] get_branches()
{
string branches = shell.send_wait("git branch");
return branches.split("\n");
}
string create_branch(string branch)
{
return shell.send_wait("git branch "+branch);
}
string switch_branch(string branch)
{
return shell.send_wait("git switch "+branch);
}
string merge_branch(string branch)
{
return shell.send_wait("git merge "+branch);
}
}