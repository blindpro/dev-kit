class git
{
bool has_git()
{
string output = shell.send_wait("git vversion");
if(output.find("not recognized") !=-1)
{
return false;
}
else
{
return true;
}
}
string create_repo()
{
return shell.send_wait("git init");
}
string get_status()
{
return shell.send_wait("git status");
}
string stage_all()
{
return shell.send_wait("git add .");
}
string commit()
{
return shell.send_wait("git commit");
}
bool has_remotes()
{
string remotes = shell.send_wait("git remote");
return remotes != "";
}
string[] get_remotes()
{
string remotes = shell.send_wait("git remote");
return remotes.split("\n");
}
string add_remote(string name, string url)
{
return shell.send_wait("git remote add "+name+" "+url);
}
string delete_remote(string name)
{
return shell.send_wait("git remote remove "+name);
}
string get_remote_url(string name)
{
return shell.send_wait("git remote get-url "+name);
}
string push()
{
return shell.send_wait("git push");
}
string[] get_branches()
{
string branches = shell.send_wait("git branch");
return branches.split("\n");
}
string create_branch(string branch)
{
return shell.send_wait("git branch "+branch);
}
string switch_branch(string branch)
{
return shell.send_wait("git switch "+branch);
}
string merge_branch(string branch)
{
return shell.send_wait("git merge "+branch);
}
string delete_branch(string branch)
{
return shell.send_wait("git branch -D "+branch);
}
string[] get_history()
{
string history = shell.send_wait("git log --oneline");
return history.split("\n");
}
}