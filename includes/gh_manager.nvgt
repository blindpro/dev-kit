class gh_manager
{
bool show_gh;
bool has_gh;
gh_manager()
{
has_gh = detect_gh();
bool remotes = g.has_remotes();
if(has_gh and remotes)
{
show_gh = true;
}
else
{
show_gh = false;
}
}
bool detect_gh()
{
string output = shell.send_wait("gh version");
if(output.find("not recognized")!=-1)
{
return false;
}
return true;
}

}