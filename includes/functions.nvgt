void setup()
{
gui.create_button("git management",load_git);
gui.add_exit_button("exit");
gui.create_screen("home");
gui.clear_all_controls();
gui.create_button("home",load_home);
if(p.has_repo == false)
{
gui.create_button("create git rapozatory",create_repo);
}
else
{
gui.create_button("check repo status",speak_status);
gui.create_button("commit to repo",commit);
}
gui.add_exit_button("exit");
gui.create_screen("git");
}