void setup()
{
build_home_screen();
build_git_screen();
build_project_screen();
build_branch_screen();
}
void build_home_screen()
{
gui.create_button("project management",load_project);
gui.create_button("git management",load_git);
gui.add_exit_button("exit");
gui.create_screen("home");
gui.clear_all_controls();
}
void build_git_screen()
{
gui.create_button("home",load_home);
if(p.has_repo == false)
{
gui.create_button("create git rapozatory",on_create_repo);
}
else
{
gui.create_button("check repo status",on_check_status);
gui.create_button("stage all files",on_stage_all);
gui.create_button("commit to repo",on_commit);
if(g.has_remotes())
{
gui.create_button("push to remote",on_push);
}
gui.create_button("manage branches",load_branch);
}
gui.add_exit_button("exit");
gui.create_screen("git");
gui.clear_all_controls();
}
void build_project_screen()
{
gui.create_button("home",load_home);
gui.create_button("view project info",on_view_project_info);
gui.create_button("build project",on_build);
gui.create_button("run project",on_run);
gui.add_exit_button("exit");
gui.create_screen("project");
gui.clear_all_controls();
}
void build_branch_screen()
{
gui.create_button("home",load_home);
gui.create_button("create new branch",on_create_branch);
gui.create_list("branches");
gui.create_button("switch branch",on_switch_branch);
gui.create_button("merge branch",on_merge_branch);
gui.add_exit_button("exit");
gui.create_screen("branch management");
gui.clear_all_controls();
}